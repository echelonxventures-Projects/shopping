{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "files": [],
  "references": [
    { "path": "./kernel/primitives" },
    { "path": "./kernel/registry" },
    { "path": "./kernel/context" },
    { "path": "./kernel/uid" },
    { "path": "./kernel/codegen" }
  ]
}
