        { "name": "storageCompliance", "group": "compliance", "type": "string" },
        { "name": "prescriptionRequired", "group": "compliance", "type": "boolean", "validation": { "required": true } }
      ]
    },
    {
      "id": "attrs_digital", "name": "digital_core",
