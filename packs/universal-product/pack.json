        { "name": "manufacturingDate", "group": "compliance", "type": "string" },
        { "name": "storageCondition", "group": "compliance", "type": "enum", "enumValues": ["ambient", "chilled", "frozen"], "validation": { "required": true } },
        { "name": "temperatureMaxC", "group": "compliance", "type": "measure", "unit": "celsius" },
        { "name": "lotNumber", "group": "compliance", "type": "string", "validation": { "required": true } },
        { "name": "ingredients", "group": "nutritional", "type": "array" },
        { "name": "allergens", "group": "nutritional", "type": "array" },
        { "name": "countryOfOrigin", "group": "compliance", "type": "string", "validation": { "required": true } },
        { "name": "caloriesPer100g", "group": "nutritional", "type": "measure", "unit": "kcal" },
        { "name": "organicCertified", "group": "compliance", "type": "boolean" }
      ]
    },
    {
      "id": "attrs_furniture", "name": "furniture_core",
      "bindsTo": { "taxonomyPath": "dom_furniture" },
