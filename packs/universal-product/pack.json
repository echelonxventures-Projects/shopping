    { "name": "course", "fulfillment": "digital", "inventoryTracked": "none", "entitlement": { "mode": "account-bound", "limits": { "seats": 1 } }, "requires": ["product_master_universal", "digital_core"] },
    { "name": "event-ticket", "fulfillment": "digital", "inventoryTracked": "serialized", "entitlement": { "mode": "license-key" }, "requires": ["product_master_universal"] },
    { "name": "insurance", "fulfillment": "none", "inventoryTracked": "none", "entitlement": { "mode": "account-bound" }, "requires": ["product_master_universal"] }
