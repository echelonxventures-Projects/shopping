        { "name": "torqueRatingNm", "group": "specifications", "type": "measure", "unit": "nm" }
      ]
    },
    {
      "id": "attrs_auto", "name": "automotive_core",
      "bindsTo": { "taxonomyPath": "dom_auto" },
