  "productTypes": [
    { "name": "physical", "fulfillment": "physical", "inventoryTracked": "simple", "requires": ["product_master_universal"] },
    { "name": "perishable", "fulfillment": "physical", "inventoryTracked": "batch-lot", "requires": ["product_master_universal", "grocery_compliance"] },
    { "name": "pharma", "fulfillment": "physical", "inventoryTracked": "serialized", "requires": ["product_master_universal", "pharma_compliance"] },
    { "name": "digital", "fulfillment": "digital", "inventoryTracked": "none", "entitlement": { "mode": "license-key", "limits": { "devices": 5, "downloads": 10 } }, "requires": ["product_master_universal", "digital_core"] },
    { "name": "service", "fulfillment": "service", "inventoryTracked": "none", "entitlement": { "mode": "booking-slot" }, "requires": ["product_master_universal", "services_core"] },
