        { "name": "countryOfOrigin", "group": "compliance", "type": "string" },
        { "name": "brand", "group": "identity", "type": "string" },
        { "name": "unspsc", "group": "classification", "type": "string" },
        { "name": "gpc", "group": "classification", "type": "string" }
      ]
    }
