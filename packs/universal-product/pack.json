        { "name": "imei", "group": "identity", "type": "string" },
        { "name": "serialNumber", "group": "identity", "type": "string" },
        { "name": "firmwareVersion", "group": "specifications", "type": "string" },
        { "name": "warrantyMonths", "group": "compliance", "type": "number" },
        { "name": "voltage", "group": "specifications", "type": "measure", "unit": "volt" },
