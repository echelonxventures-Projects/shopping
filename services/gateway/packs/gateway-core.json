{
  "$comment": "Gateway core pack \u2014 the ENTIRE HTTP surface as data. Each route binds method+path to a module apiMethod with an argument mapper expression and required scope. Demo API keys are pack data (swap in real auth via KMS-backed packs in production). Rate limits and CORS are config.",
  "pack": {
    "name": "gateway-core",
    "version": "1.0.0",
    "kind": "capability-pack"
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8787,
    "publicBaseUrl": "http://127.0.0.1:8787",
    "tls": {
      "envCert": "AETHER_TLS_CERT_FILE",
      "envKey": "AETHER_TLS_KEY_FILE",
      "hstsMaxAgeSeconds": 31536000
    }
  },
  "cors": {
    "allowOrigins": [
      "*"
    ],
    "allowMethods": [
      "GET",
      "POST"
    ]
  },
  "apiKeys": [
    {
      "key": "demo-admin-key-0000",
      "name": "demo-admin",
      "scopes": [
        "catalog:read",
        "catalog:write",
        "orders:read",
        "orders:write",
        "inventory:write",
        "tax:read",
        "pricing:read",
        "geo:read",
        "search:read",
        "payments:write",
        "ai:use",
        "evidence:read",
        "orders:read",
        "orders:write",
        "billing:read",
        "billing:write"
      ]
    },
    {
      "key": "demo-shopper-key-0000",
      "name": "demo-shopper",
      "scopes": [
        "catalog:read",
        "search:read",
        "pricing:read",
        "tax:read",
        "geo:read",
        "ai:use",
        "orders:read",
        "billing:read"
      ]
    }
  ],
  "rateLimits": {
    "requestsPerMinute": 600,
    "burst": 50,
    "store": "inline"
  },
  "routes": [
    {
      "method": "GET",
      "path": "/openapi.json",
      "module": "gateway",
      "api": "openapi",
      "scope": null,
      "auth": false,
      "map": "{}",
      "desc": "OpenAPI 3.1 spec generated from this pack"
    },
    {
      "method": "GET",
      "path": "/health",
      "module": "gateway",
      "api": "routes",
      "scope": null,
      "map": "{}",
      "desc": "List all routes (self-describing API)",
      "auth": false
    },
    {
      "method": "POST",
      "path": "/catalog/products",
      "module": "mod-catalog",
      "api": "createProduct",
      "scope": "catalog:write",
      "map": "{\"tenantId\":\"demo-tenant\",\"attrs\":\"$.body\",\"aliases\":\"$.body.aliases||[]\"}",
      "desc": "Create product (attrs from body)"
    },
    {
      "method": "GET",
      "path": "/catalog/products/:id/offers",
      "module": "mod-catalog",
      "api": "listOffers",
      "scope": "catalog:read",
      "map": "{\"tenantId\":\"demo-tenant\",\"productId\":\"$.params.id\"}",
      "desc": "List offers for product"
    },
    {
      "method": "GET",
      "path": "/catalog/buybox/:id",
      "module": "mod-catalog",
      "api": "buyBox",
      "scope": "catalog:read",
      "map": "{\"tenantId\":\"demo-tenant\",\"productId\":\"$.params.id\"}",
      "desc": "Buy-box winner"
    },
    {
      "method": "POST",
      "path": "/catalog/offers",
      "module": "mod-catalog",
      "api": "addOffer",
      "scope": "catalog:write",
      "map": "{\"tenantId\":\"demo-tenant\",\"productId\":\"$.body.productId\",\"offer\":\"$.body.offer\"}",
      "desc": "Add offer to product"
    },
    {
      "method": "GET",
      "path": "/search",
      "module": "mod-search",
      "api": "search",
      "scope": "search:read",
      "map": "{\"tenantId\":\"demo-tenant\",\"text\":\"$.query.q\",\"limit\":\"$.query.limit||10\"}",
      "desc": "Search products",
      "argsMode": "object"
    },
    {
      "method": "POST",
      "path": "/search/index",
      "module": "mod-search",
      "api": "indexProduct",
      "scope": "catalog:write",
      "map": "{\"tenantId\":\"demo-tenant\",\"product\":\"$.body.product\",\"extra\":\"$.body.extra\"}",
      "desc": "Index a product for search"
    },
    {
      "method": "POST",
      "path": "/inventory/reserve",
      "module": "mod-inventory",
      "api": "reserve",
      "scope": "inventory:write",
      "map": "{\"lines\":\"$.body.lines\"}",
      "desc": "Atomic stock reserve",
      "argsMode": "object"
    },
    {
      "method": "POST",
      "path": "/tax/compute",
      "module": "mod-tax",
      "api": "compute",
      "scope": "tax:read",
      "map": "{\"fact\":\"$.body.fact\",\"lines\":\"$.body.lines\"}",
      "desc": "Compute tax for lines"
    },
    {
      "method": "POST",
      "path": "/pricing/quote",
      "module": "mod-pricing",
      "api": "quote",
      "scope": "pricing:read",
      "map": "{\"sku\":\"$.body.sku\",\"qty\":\"$.body.qty||1\",\"cartSkus\":\"$.body.cartSkus||[]\",\"ctx\":\"$.body.ctx\",\"at\":\"$.body.at\"}",
      "desc": "Price quote w/ promos"
    },
    {
      "method": "POST",
      "path": "/geo/zones",
      "module": "mod-geo",
      "api": "resolveZones",
      "scope": "geo:read",
      "map": "{\"country\":\"$.body.country\",\"region\":\"$.body.region||null\",\"postalCode\":\"$.body.postalCode||null\"}",
      "desc": "Resolve zones for address",
      "argsMode": "object"
    },
    {
      "method": "POST",
      "path": "/geo/nearest",
      "module": "mod-geo",
      "api": "nearestNodes",
      "scope": "geo:read",
      "map": "{\"point\":\"$.body.point\",\"capability\":\"$.body.capability||ship-from-store\"}",
      "desc": "Nearest fulfillment nodes",
      "argsMode": "object"
    },
    {
      "method": "POST",
      "path": "/payments/authorize",
      "module": "mod-payments",
      "api": "authorize",
      "scope": "payments:write",
      "map": "{\"total\":\"$.body.total\",\"currency\":\"$.body.currency\",\"token\":\"$.body.token\"}",
      "desc": "Authorize payment (token only \u2014 SAQ-A)"
    },
    {
      "method": "POST",
      "path": "/ai/assistant",
      "module": "mod-ai-commerce",
      "api": "assistantRespond",
      "scope": "ai:use",
      "map": "{\"sessionId\":\"$.body.sessionId\",\"message\":\"$.body.message\"}",
      "desc": "Shopping assistant turn (EU AI Act disclosed)"
    },
    {
      "method": "POST",
      "path": "/ai/visual-search",
      "module": "mod-ai-commerce",
      "api": "visualQuery",
      "scope": "ai:use",
      "map": "{\"text\":\"$.body.text\",\"candidates\":\"$.body.candidates||[]\"}",
      "desc": "Visual search query"
    },
    {
      "method": "POST",
      "path": "/orders",
      "module": "mod-orders",
      "api": "place",
      "scope": "orders:write",
      "argsMode": "positional",
      "map": "{\"0\":\"$.body.order\"}",
      "desc": "Place order (order record from body)"
    },
    {
      "method": "GET",
      "path": "/orders/:id",
      "module": "mod-orders",
      "api": "get",
      "scope": "orders:read",
      "map": "{\"tenantId\":\"demo-tenant\",\"id\":\"$.params.id\"}",
      "desc": "Get order (bitemporal current version)"
    },
    {
      "method": "POST",
      "path": "/orders/:id/transition",
      "module": "mod-orders",
      "api": "transition",
      "scope": "orders:write",
      "map": "{\"tenantId\":\"demo-tenant\",\"orderId\":\"$.params.id\",\"to\":\"$.body.to\",\"trigger\":\"$.body.trigger\"}",
      "desc": "Lifecycle transition (pack workflow)"
    },
    {
      "method": "GET",
      "path": "/orders/:id/history",
      "module": "mod-orders",
      "api": "history",
      "scope": "orders:read",
      "map": "{\"tenantId\":\"demo-tenant\",\"orderId\":\"$.params.id\"}",
      "desc": "Full bitemporal event history"
    },
    {
      "method": "POST",
      "path": "/checkout",
      "module": "mod-checkout",
      "api": "checkout",
      "scope": "orders:write",
      "argsMode": "object",
      "demoSaga": true,
      "map": "{\"tenantId\":\"demo-tenant\",\"cartLines\":\"$.body.lines\",\"idem\":\"$.body.idem||auto\"}",
      "desc": "Checkout saga (authorize->reserve->capture->commit w/ compensation; demo PSP + in-memory stock)"
    },
    {
      "method": "POST",
      "path": "/monetization/meter",
      "module": "mod-monetization",
      "api": "meter",
      "scope": "billing:write",
      "argsMode": "positional",
      "map": "{\"0\":\"$.body.event\"}",
      "desc": "Meter usage event (tenantId, resource, qty, at)"
    },
    {
      "method": "POST",
      "path": "/monetization/invoice",
      "module": "mod-monetization",
      "api": "invoice",
      "scope": "billing:write",
      "argsMode": "positional",
      "map": "{\"0\":\"$.body.tenantId||demo-tenant\",\"1\":\"$.body.periodStart\",\"2\":\"$.body.periodEnd\"}",
      "desc": "Generate invoice for period"
    },
    {
      "method": "GET",
      "path": "/monetization/usage/:tenant",
      "module": "mod-monetization",
      "api": "usage",
      "scope": "billing:read",
      "map": "{\"0\":\"$.params.tenant\",\"1\":\"$.query.resource\"}",
      "desc": "Usage totals for tenant/resource",
      "argsMode": "positional"
    },
    {
      "method": "GET",
      "path": "/monetization/entitlement/:tenant",
      "module": "mod-monetization",
      "api": "entitlement",
      "scope": "billing:read",
      "argsMode": "positional",
      "map": "{\"0\":\"$.params.tenant\",\"1\":\"$.query.feature\"}",
      "desc": "Feature entitlement check (plan/addon/quota)"
    },
    {
      "method": "POST",
      "path": "/monetization/subscribe",
      "module": "mod-monetization",
      "api": "subscribe",
      "scope": "billing:write",
      "argsMode": "positional",
      "map": "{\"0\":\"$.body.tenantId||demo-tenant\",\"1\":\"$.body.planId||plan_growth\"}",
      "desc": "Subscribe tenant to a plan (plan_starter/plan_growth/plan_enterprise)"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "module": "mod-identity",
      "api": "register",
      "scope": null,
      "auth": false,
      "argsMode": "positional",
      "map": "{\"0\":\"$.body.email\",\"1\":\"$.body.password\",\"2\":\"$.body.name||\"}",
      "desc": "Register customer -> customer id + session token"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "module": "mod-identity",
      "api": "login",
      "scope": null,
      "auth": false,
      "argsMode": "positional",
      "map": "{\"0\":\"$.body.email\",\"1\":\"$.body.password\"}",
      "desc": "Login -> session token (Authorization: Bearer <token>)"
    },
    {
      "method": "GET",
      "path": "/auth/me",
      "module": "mod-identity",
      "api": "me",
      "scope": "shopper",
      "argsMode": "positional",
      "map": "{\"0\":\"$.session_token\"}",
      "desc": "Who am I (session-resolved)"
    },
    {
      "method": "POST",
      "path": "/cart/add",
      "module": "mod-cart",
      "api": "add",
      "scope": "shopper",
      "argsMode": "positional",
      "map": "{\"0\":\"$.session.customerId\",\"1\":\"$.body.line\"}",
      "desc": "Add item to cart {offerId, productId, title, sellerId, price, qty}"
    },
    {
      "method": "GET",
      "path": "/cart",
      "module": "mod-cart",
      "api": "get",
      "scope": "shopper",
      "argsMode": "positional",
      "map": "{\"0\":\"$.session.customerId\"}",
      "desc": "View cart with totals"
    },
    {
      "method": "POST",
      "path": "/cart/update",
      "module": "mod-cart",
      "api": "update",
      "scope": "shopper",
      "argsMode": "positional",
      "map": "{\"0\":\"$.session.customerId\",\"1\":\"$.body.offerId\",\"2\":\"$.body.qty\"}",
      "desc": "Update line qty (0 removes)"
    },
    {
      "method": "POST",
      "path": "/cart/remove",
      "module": "mod-cart",
      "api": "remove",
      "scope": "shopper",
      "argsMode": "positional",
      "map": "{\"0\":\"$.session.customerId\",\"1\":\"$.body.offerId\"}",
      "desc": "Remove line"
    },
    {
      "method": "POST",
      "path": "/shop/checkout",
      "module": "mod-checkout",
      "api": "checkout",
      "scope": "shopper",
      "argsMode": "object",
      "demoSaga": true,
      "shopperSaga": true,
      "map": "{\"tenantId\":\"demo-tenant\",\"cartLines\":\"$.cart_lines\",\"idem\":\"$.body.idem||auto\"}",
      "desc": "Checkout the session cart via saga (demo PSP + stock)"
    }
  ],
  "keyProvider": {
    "mode": "demo-inline",
    "$comment": "Credential source: demo-inline = keys in this pack (dev only). production-class adapters: secret-file (KMS/Vault-agent mounted JSON file) or host-resolved (external host supplies via mountKeyProvider). Zero code change to swap."
  }
}