{
  "$comment": "Infra composer pack \u2014 deployment shapes per product, runtime target, sizing classes, IaC output policies. All DATA: topology generation is configuration.",
  "pack": {
    "name": "infra-composer-core",
    "version": "1.0.0",
    "kind": "capability-pack"
  },
  "runtimeTarget": {
    "id": "rt-k8s-anywhere",
    "kind": "kubernetes",
    "apiVersion": "apps/v1",
    "runtime": "container-orchestrated"
  },
  "sizingClasses": {
    "kernel": {
      "replicas": 3,
      "cpuMilli": 500,
      "memoryMi": 512,
      "hpa": {
        "min": 3,
        "max": 20,
        "targetCpuPct": 70
      }
    },
    "commerce-hot-path": {
      "replicas": 5,
      "cpuMilli": 1000,
      "memoryMi": 1024,
      "hpa": {
        "min": 5,
        "max": 50,
        "targetCpuPct": 65
      }
    },
    "batch": {
      "replicas": 1,
      "cpuMilli": 250,
      "memoryMi": 256,
      "hpa": null
    }
  },
  "deploymentShapes": [
    {
      "appliesToProducts": [
        "mod-catalog",
        "mod-checkout",
        "mod-orders",
        "mod-inventory",
        "mod-payments",
        "mod-search"
      ],
      "sizingClass": "commerce-hot-path",
      "deployment": "stateless"
    },
    {
      "appliesToProducts": [
        "mod-tax",
        "mod-monetization",
        "mod-marketplace",
        "mod-b2b",
        "mod-ads-auction",
        "mod-agentic-commerce",
        "mod-ai-commerce"
      ],
      "sizingClass": "kernel",
      "deployment": "stateless"
    },
    {
      "appliesToProducts": [
        "mod-onboarding",
        "mod-recommendations",
        "mod-experimentation",
        "mod-compliance-evidence",
        "mod-mobile-ops",
        "mod-offline-mode",
        "mod-waiting-room",
        "mod-settlement"
      ],
      "sizingClass": "batch",
      "deployment": "stateless"
    },
    {
      "appliesToProducts": [
        "*"
      ],
      "sizingClass": "kernel",
      "deployment": "stateless"
    }
  ],
  "dataPlane": {
    "stores": [
      {
        "id": "primary-sql",
        "engine": "sql-engine",
        "class": "relational",
        "haMode": "region-pinned",
        "backup": {
          "pitr": true,
          "retentionDays": 30
        }
      },
      {
        "id": "cache",
        "engine": "memory-engine",
        "class": "kv",
        "haMode": "replicated",
        "backup": {
          "pitr": false,
          "retentionDays": 0
        }
      }
    ],
    "searchIndex": {
      "engine": "memory-search",
      "class": "search",
      "haMode": "replicated"
    }
  },
  "outputs": {
    "formats": [
      "k8s-manifest",
      "topology-json"
    ],
    "namespacePrefix": "aether"
  },
  "deploy": {
    "$comment": "Deploy-mode data: single-image mode boots the whole self-hosted platform (all modules in-process, model-driven gateway). Multi-image mode renders per-product Deployments (compose() output) when products ship standalone binaries.",
    "mode": "single-image",
    "imageName": "aether-platform",
    "imageTag": "local",
    "namespace": "aether",
    "replicas": 2,
    "service": {
      "type": "ClusterIP",
      "port": 8787
    },
    "adapter": "{runtimeAdapters.selected}"
  },
  "runtimeAdapters": {
    "$comment": "Total Agnosticism applied to the deploy tooling itself: cluster runtimes (docker-class, podman-class, registry-class, ...) are swappable Reference Packs declared as ordered step lists of command TEMPLATES (pack data). The executor (scripts/deploy.ts) is invariant mechanics \u2014 it resolves the selected adapter and runs its steps. Swapping tooling = change 'selected' (or AETHER_DEPLOY_ADAPTER), zero code. Placeholders: {image} {imageRef} {tarball} {dockerfile} {releaseName} {namespace} {timeout}.",
    "selected": "docker-colima-class",
    "defaultTimeout": "180s",
    "adapters": {
      "docker-colima-class": {
        "kind": "container-cli-class",
        "imageRef": "docker.io/library/{image}",
        "steps": [
          "build",
          "save",
          "copy-to-node",
          "node-import",
          "apply",
          "rollout"
        ],
        "commands": {
          "build": {
            "cmd": "docker",
            "args": [
              "build",
              "-t",
              "{image}",
              "-f",
              "{dockerfile}",
              ".",
              "--quiet"
            ],
            "skipIf": {
              "cmd": "docker",
              "args": [
                "image",
                "inspect",
                "{image}"
              ],
              "expectSuccess": true
            }
          },
          "save": {
            "cmd": "docker",
            "args": [
              "save",
              "{image}",
              "-o",
              "{tarball}"
            ]
          },
          "copy-to-node": {
            "multi": [
              {
                "cmd": "scp",
                "args": [
                  "-F",
                  "~/.colima/ssh_config",
                  "{tarball}",
                  "colima:{tarball}"
                ]
              },
              {
                "cmd": "scp",
                "args": [
                  "-F",
                  "~/.colima/ssh_config",
                  "scripts/adapters/docker-colima-class/import.sh",
                  "colima:/tmp/import.sh"
                ]
              }
            ]
          },
          "node-import": {
            "cmd": "colima",
            "args": [
              "ssh",
              "--",
              "sh",
              "/tmp/import.sh"
            ]
          },
          "apply": {
            "cmd": "kubectl",
            "args": [
              "apply",
              "-f",
              "-"
            ],
            "stdin": "manifests"
          },
          "rollout": {
            "cmd": "kubectl",
            "args": [
              "rollout",
              "status",
              "deployment/{releaseName}",
              "-n",
              "{namespace}",
              "--timeout={timeout}"
            ]
          }
        }
      },
      "podman-kind-class": {
        "kind": "container-cli-class",
        "steps": [
          "build",
          "save",
          "node-load",
          "apply",
          "rollout"
        ],
        "commands": {
          "build": {
            "cmd": "podman",
            "args": [
              "build",
              "-t",
              "{image}",
              "-f",
              "{dockerfile}",
              "."
            ],
            "skipIf": {
              "cmd": "podman",
              "args": [
                "image",
                "exists",
                "{image}"
              ],
              "expectSuccess": true
            }
          },
          "save": {
            "cmd": "podman",
            "args": [
              "save",
              "-o",
              "{tarball}",
              "{image}"
            ]
          },
          "node-load": {
            "cmd": "kind",
            "args": [
              "load",
              "image-archive",
              "{tarball}"
            ]
          },
          "apply": {
            "cmd": "kubectl",
            "args": [
              "apply",
              "-f",
              "-"
            ],
            "stdin": "manifests"
          },
          "rollout": {
            "cmd": "kubectl",
            "args": [
              "rollout",
              "status",
              "deployment/{releaseName}",
              "-n",
              "{namespace}",
              "--timeout={timeout}"
            ]
          }
        }
      },
      "registry-class": {
        "kind": "registry-class",
        "$comment": "production path: image pushed to a registry by CI; nodes pull \u2014 no build/load steps in the plan.",
        "imageRef": "{registry}/{image}",
        "steps": [
          "apply",
          "rollout"
        ],
        "commands": {
          "apply": {
            "cmd": "kubectl",
            "args": [
              "apply",
              "-f",
              "-"
            ],
            "stdin": "manifests"
          },
          "rollout": {
            "cmd": "kubectl",
            "args": [
              "rollout",
              "status",
              "deployment/{releaseName}",
              "-n",
              "{namespace}",
              "--timeout={timeout}"
            ]
          }
        }
      }
    }
  }
}